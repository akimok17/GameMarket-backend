# =========================
# GameMarket v2.5.0
# =========================
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/marketplace
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CONTENT_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COMMISSION_RATE=0.05
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:8000
ALLOW_DEV_DEPOSITS=true
CREATE_TABLES_ON_STARTUP=true
MIGRATE_LEGACY_SCHEMA=true
AUTO_COMPLETE_HOURS=24

# =========================
# Verification policies
# none | any | email | phone | both
# Recommended production values for a marketplace: both for sellers/withdrawals.
# =========================
REQUIRE_VERIFIED_FOR_SELLING=true
REQUIRE_VERIFIED_FOR_WITHDRAWAL=true
SELLER_VERIFICATION_POLICY=any
WITHDRAWAL_VERIFICATION_POLICY=both
PASSWORD_RESET_CHANNELS=email,phone

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_MAX_SENDS_PER_HOUR=5
VERIFICATION_MAX_SENDS_PER_IP_HOUR=20
OTP_DEV_ECHO=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# =========================
# Email sender (one GameMarket mailbox -> any user's personal email)
# Mail.ru example: smtp.mail.ru:465 SSL + application password.
# =========================
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=GameMarket
SMTP_REPLY_TO=support@example.com
SMTP_SECURITY=ssl
SMTP_TIMEOUT_SECONDS=30
# auto normally; tls1_2 can help behind VPN/proxy that breaks TLS negotiation.
SMTP_TLS_VERSION=auto

# =========================
# SMS: smsru | twilio | generic | none
# =========================
SMS_PROVIDER=none
SMS_TIMEOUT_SECONDS=15

# SMS.RU
SMSRU_API_ID=
SMSRU_FROM=

# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Custom JSON SMS gateway
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

SUPPORT_EMAIL=support@example.com
ORDER_WS_TOKEN_MINUTES=10
ORDER_ATTACHMENT_MAX_MB=5

# =========================
# Real money: YooKassa
# =========================
# Payments: none | yookassa
PAYMENT_PROVIDER=none
PAYMENT_TIMEOUT_SECONDS=20
DEPOSIT_MIN_RUB=10
DEPOSIT_MAX_RUB=150000
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Leave empty to use PUBLIC_APP_URL/profile?payment_return=...
YOOKASSA_RETURN_URL=
ANDROID_PAYMENT_RETURN_URL=https://your-domain.ru/payment-return

# Payouts: none | manual | yookassa
# "manual" keeps admin-reviewed withdrawals without calling an external API.
# "yookassa" enables automatic SBP payouts after admin approval.
PAYOUT_PROVIDER=manual
WITHDRAWAL_MIN_RUB=100
WITHDRAWAL_MAX_RUB=100000
YOOKASSA_PAYOUT_GATEWAY_ID=
YOOKASSA_PAYOUT_SECRET_KEY=

# YooKassa webhook URL to configure in the merchant cabinet:
# https://YOUR_DOMAIN/payments/yookassa/webhook
# Subscribe to: payment.succeeded, payment.canceled,
# payout.succeeded, payout.canceled (when payouts are enabled).
